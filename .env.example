# Optional production settings. XAMPP can still use includes/db_connect.php defaults.
CROSSROAD_DB_HOST=localhost
CROSSROAD_DB_PORT=3306
CROSSROAD_DB_NAME=crossroad_solutions_inventory_management
CROSSROAD_DB_USER=root
CROSSROAD_DB_PASS=

# Recommended: set this in your server environment instead of hardcoding Gmail app passwords.
CROSSROAD_SMTP_HOST=smtp.gmail.com
CROSSROAD_SMTP_PORT=587
CROSSROAD_SMTP_USER=crossroadinventory@gmail.com
CROSSROAD_SMTP_PASSWORD=
CROSSROAD_SMTP_FROM=crossroadinventory@gmail.com
CROSSROAD_SMTP_FROM_NAME=Crossroad System
CROSSROAD_SMTP_ENCRYPTION=tls

# Secret used only when invoking the planner reminder runner through HTTP.
CROSSROAD_PLANNER_CRON_KEY=

# Telegram bot settings. CROSSROAD_BASE_URL must be the public HTTPS site URL.
# Generate CROSSROAD_TELEGRAM_WEBHOOK_SECRET as a random string of 32+ characters.
CROSSROAD_TELEGRAM_BOT_TOKEN=
CROSSROAD_TELEGRAM_BOT_USERNAME=Cssb_Planner_bot
CROSSROAD_TELEGRAM_WEBHOOK_SECRET=
CROSSROAD_BASE_URL=https://inventory.example.com

# Realtime updates. The publish URL stays private on the server; the public URL
# is the secure WebSocket endpoint exposed by the Plesk reverse proxy.
CROSSROAD_REALTIME_PUBLIC_URL=wss://inventory.example.com/realtime/ws
CROSSROAD_REALTIME_PUBLISH_URL=http://127.0.0.1:8081/publish
CROSSROAD_REALTIME_PORT=8081
CROSSROAD_REALTIME_SECRET=
